# 이 파일을 .env로 복사해서 값을 채운다. .env는 git에 올라가지 않는다.
# 공공데이터포털 마이페이지 > 활용신청 > 일반 인증키 (Encoding/Decoding 어느 쪽이든 된다)
# 같은 키로 기상청 단기예보 조회서비스와 ASOS 시간자료 조회서비스를 모두 쓴다
KMA_SERVICE_KEY=

# true면 매일 01:00 관측, 17:30 예보 수집, 17:40 내일 예측을 실제로 돌린다
LIVE_ENABLED=false

ADMIN_USER=admin
ADMIN_PASSWORD=admin
SLACK_WEBHOOK_URL=
